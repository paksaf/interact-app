<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Interact Talk</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>interact_talk</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- Required for flutter_contacts (invite-from-address-book). Read-only. -->
		<key>NSContactsUsageDescription</key>
		<string>INTERACT uses your contacts so you can invite people from your address book. Contacts stay on your device and are never uploaded.</string>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<true/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
		<!-- Calls: WebRTC mic/camera. iOS KILLS the process (TCC crash) if these
		     keys are absent when getUserMedia runs — required, not cosmetic. -->
		<key>NSMicrophoneUsageDescription</key>
		<string>INTERACT Talk uses the microphone for voice and video calls and voice messages.</string>
		<key>NSCameraUsageDescription</key>
		<string>INTERACT Talk uses the camera for video calls and to share photos in chat.</string>
		<!-- Chat media: image_picker / file_picker -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>INTERACT Talk lets you pick photos and videos from your library to share in chat.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>INTERACT Talk can save received photos and videos to your library.</string>
		<!-- speech_to_text -->
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>INTERACT Talk transcribes your voice to text when you dictate a message.</string>
		<!-- Keep calls alive when the app is backgrounded -->
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>voip</string>
			<string>remote-notification</string>
		</array>
		<!-- BLE mesh / nearby devices scan -->
		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>INTERACT Talk uses Bluetooth to find nearby phones and devices for offline mesh and status.</string>
		<key>NSBluetoothPeripheralUsageDescription</key>
		<string>INTERACT Talk uses Bluetooth to find nearby phones and devices for offline mesh and status.</string>
		<!-- Offline LAN Direct mode — Multipeer Connectivity (nearby_service) -->
		<key>NSBonjourServices</key>
		<array>
			<string>_mp-connection._tcp</string>
			<string>_interact-lan._tcp</string>
		</array>
		<key>NSLocalNetworkUsageDescription</key>
		<string>INTERACT Talk finds nearby phones on the same Wi‑Fi or via peer-to-peer for offline chat without internet.</string>
		<key>UIRequiresPersistentWiFi</key>
		<true/>
	</dict>
</plist>
